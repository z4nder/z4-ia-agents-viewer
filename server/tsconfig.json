{
    "compilerOptions": {
        "target": "ES2023",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "strict": true,
        "noEmit": true,
        "skipLibCheck": true,
        "isolatedModules": true,
        "noUncheckedIndexedAccess": true,
        "lib": ["ES2023"],
        "types": ["bun"]
    },
    "include": ["./**/*.ts"]
}
